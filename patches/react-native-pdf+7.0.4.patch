+@protocol RNPDFNightModeProviding <NSObject>
+- (BOOL)isNightModeEnabled;
+@end
+
+// PDFKit has no public night-mode switch. Render the normal page first, then
+// blend an opaque white rectangle with Difference mode: white becomes black
+// and black becomes white while the surrounding reader chrome is untouched.
+@interface RNPDFNightPage : PDFPage
+@end
+
+@implementation RNPDFNightPage
+- (void)drawWithBox:(PDFDisplayBox)box toContext:(CGContextRef)context
+{
+    [super drawWithBox:box toContext:context];
+
+    id<RNPDFNightModeProviding> provider = (id<RNPDFNightModeProviding>)self.document.delegate;
+    if ([provider respondsToSelector:@selector(isNightModeEnabled)] && [provider isNightModeEnabled]) {
+        CGContextSaveGState(context);
+        CGContextSetBlendMode(context, kCGBlendModeDifference);
+        CGContextSetRGBFillColor(context, 1.0, 1.0, 1.0, 1.0);
+        CGContextFillRect(context, [self boundsForBox:box]);
+        CGContextRestoreGState(context);
+    }
+}
+@end
+
