{
  "expo": {
    "name": "Sober Dailies",
    "slug": "sober-dailies",
    "version": "3.5.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nealwagner.soberdailies",
      "buildNumber": "139",
      "icon": "./assets/images/icon.png",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "audio"
        ],
        "UISupportedInterfaceOrientations": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationPortraitUpsideDown",
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight"
        ]
      },
      "entitlements": {}
    },
    "android": {
      "package": "com.nealwagner.soberdailies",
      "versionCode": 139,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon-foreground.png",
        "backgroundImage": "./assets/images/adaptive-icon-background.png",
        "monochromeImage": "./assets/images/adaptive-icon-monochrome.png"
      },
      "icon": "./assets/images/adaptive-icon.png",
      "permissions": [
        "android.permission.VIBRATE"
      ]
    },
    "runtimeVersion": "3.5.0",
    "extra": {
      "eas": {
        "projectId": "651e2e43-404d-47e3-94ac-695b4febd27a"
      }
    },
    "web": {
      "favicon": "./assets/images/favicon.webp"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://rork.com/"
        }
      ],
      [
        "expo-splash-screen",
        {
          "ios": {
            "image": "./assets/images/splash-icon.png",
            "resizeMode": "contain",
            "backgroundColor": "#3D8B8B",
            "imageWidth": 300
          },
          "android": {
            "image": "./assets/images/splash-android-icon2.png",
            "backgroundColor": "#3D8B8B"
          }
        }
      ],
      [
        "expo-font"
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "reminders"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "allowBackup": true
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Sober Dailies needs photo access so you can pick a Meeting Guide screenshot to read a meeting's details.",
          "cameraPermission": "Sober Dailies needs camera access so you can photograph a meeting flyer to read its details."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Sober Dailies uses your contacts so you can save people to call or text when you need to reach out, and choose friends to invite to the app. Your contacts never leave your device."
        }
      ],
      "expo-web-browser",
      [
        "expo-sqlite",
        {
          "enableFTS": true,
          "useSQLCipher": true,
          "android": {
            "enableFTS": false,
            "useSQLCipher": false
          },
          "ios": {
            "customBuildFlags": [
              "-DSQLITE_ENABLE_DBSTAT_VTAB=1 -DSQLITE_ENABLE_SNAPSHOT=1"
            ]
          }
        }
      ],
      "expo-secure-store",
      "./plugins/withModularHeaders.js",
      "./plugins/withFontScaleConfigChange.js",
      [
        "react-native-cloud-storage",
        {
          "iCloudContainerEnvironment": "Production"
        }
      ],
      "expo-asset",
      "@react-native-community/datetimepicker",
      "expo-image",
      "expo-localization",
      "expo-status-bar",
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "updates": {
      "url": "https://u.expo.dev/651e2e43-404d-47e3-94ac-695b4febd27a"
    }
  }
}
